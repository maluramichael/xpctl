<Project Sdk="Microsoft.NET.Sdk">
  <!-- Test für Core/Restore.cs, Core/SaveZips.cs und Core/Zip.cs, läuft mit dem dotnet SDK auf macOS/Linux/Windows:
       Aufruf: dotnet run, Projekt server/tests/restore -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RollForward>Major</RollForward>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\..\Core\Zip.cs" Link="Zip.cs" />
    <Compile Include="..\..\Core\Restore.cs" Link="Restore.cs" />
    <Compile Include="..\..\Core\SaveZips.cs" Link="SaveZips.cs" />
  </ItemGroup>
</Project>
